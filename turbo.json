{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalDependencies": [".env*"],
    "globalPassThroughEnv": ["*"],
    "cacheDir": ".turbo/cache",
    "tasks": {
        "dev:prepare": {
            "dependsOn": ["^dev:prepare"],
            "inputs": ["src/**", "scripts/**", "package.json", "tsconfig.json", "tsconfig.*.json", "*.config.*"],
            "outputs": ["dist/**"],
            "cache": true
        },

        "dev": {
            "dependsOn": ["^dev:prepare"],
            "cache": false,
            "persistent": true
        },

        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "scripts/**", "package.json", "tsconfig.json", "tsconfig.*.json", "*.config.*"],
            "outputs": ["dist/**"],
            "cache": true
        },

        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },

        "lint": {
            "dependsOn": ["^build"]
        },

        "typecheck": {
            "dependsOn": ["^build"]
        },

        "clean": {
            "cache": false
        }
    }
}
