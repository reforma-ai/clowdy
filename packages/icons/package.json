{
    "name": "@clowdy/icons",
    "private": true,
    "license": "Apache-2.0",
    "description": "Icon library for the Clowdy design system",
    "version": "0.2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "styles": "./dist/styles.css",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./css": "./dist/styles.css",
        "./10": {
            "types": "./dist/10/index.d.ts",
            "import": "./dist/10/index.js",
            "default": "./dist/10/index.js"
        },
        "./12": {
            "types": "./dist/12/index.d.ts",
            "import": "./dist/12/index.js",
            "default": "./dist/12/index.js"
        },
        "./14": {
            "types": "./dist/14/index.d.ts",
            "import": "./dist/14/index.js",
            "default": "./dist/14/index.js"
        },
        "./16": {
            "types": "./dist/16/index.d.ts",
            "import": "./dist/16/index.js",
            "default": "./dist/16/index.js"
        },
        "./18": {
            "types": "./dist/18/index.d.ts",
            "import": "./dist/18/index.js",
            "default": "./dist/18/index.js"
        },
        "./20": {
            "types": "./dist/20/index.d.ts",
            "import": "./dist/20/index.js",
            "default": "./dist/20/index.js"
        },
        "./8": {
            "types": "./dist/8/index.d.ts",
            "import": "./dist/8/index.js",
            "default": "./dist/8/index.js"
        },
        "./assets": {
            "types": "./dist/assets/index.d.ts",
            "import": "./dist/assets/index.js",
            "default": "./dist/assets/index.js"
        },
        "./cursors": {
            "types": "./dist/cursors/index.d.ts",
            "import": "./dist/cursors/index.js",
            "default": "./dist/cursors/index.js"
        },
        "./logo": {
            "types": "./dist/logo/index.d.ts",
            "import": "./dist/logo/index.js",
            "default": "./dist/logo/index.js"
        },
        "./registry": {
            "types": "./dist/registry.d.ts",
            "import": "./dist/registry.js",
            "default": "./dist/registry.js"
        }
    },
    "scripts": {
        "build": "bun scripts/build.js",
        "clean": "rm -rf node_modules/{*,.*} .turbo dist 2>/dev/null || true",
        "dev:prepare": "bun run build",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "sync": "bun scripts/sync-icons.js",
        "test": "vitest run scripts/sync-icons.test.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@clowdy/lib": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@babel/types": "^7.28.0",
        "@svgr/core": "^8.1.0",
        "minimatch": "^10.0.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/plugin-svgo": "^8.1.0",
        "svgo": "^3.3.2"
    }
}
