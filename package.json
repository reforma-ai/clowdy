{
    "name": "clowdy",
    "private": true,
    "license": "Apache-2.0",
    "description": "Clowdy: a local desktop app for autonomous software development (working name)",
    "scripts": {
        "clowdy": "bun scripts/cli.ts",
        "dev": "bun scripts/cli.ts dev",
        "build": "bun scripts/cli.ts build",
        "lint": "turbo run lint && eslint scripts",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck && tsc --noEmit -p scripts",
        "clean": "turbo run clean && rm -rf .turbo node_modules/.cache/turbo"
    },
    "devDependencies": {
        "@babel/plugin-proposal-decorators": "^7.25.0",
        "@babel/preset-typescript": "^7.25.0",
        "@types/bun": "1.4.0",
        "@types/lodash": "^4.17.7",
        "@types/node": "^24",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-observing-components": "0.2.0",
        "css-declaration-sorter": "7.3.1",
        "esbuild": "^0.27.0",
        "eslint": "^9.39.1",
        "happy-dom": "21.0.4",
        "postcss": "^8.5.6",
        "postcss-preset-env": "11.1.1",
        "turbo": "^2.7.3",
        "typescript": "^7",
        "unocss": "66.6.0",
        "vite": "^8.3.0",
        "vite-plugin-babel": "^1.7.3",
        "vite-plugin-svgr": "4.5.0",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "lodash": "^4.17.21",
        "mobx": "^7.0.3",
        "mobx-react-lite": "^5.0.3",
        "motion": "^13.4.0"
    },
    "engines": {
        "node": ">=22.12"
    },
    "packageManager": "bun@1.4.4",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^7",
        "mobx": "^7.0.3",
        "mobx-react-lite": "^5.0.3",
        "vitest": "^5.0.1"
    }
}
