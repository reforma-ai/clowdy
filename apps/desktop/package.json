{
    "name": "@clowdy/desktop",
    "productName": "Clowdy Dev",
    "private": true,
    "version": "0.1.0",
    "description": "Clowdy desktop app",
    "type": "module",
    "main": "dist/main/index.cjs",
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "build:app": "bun scripts/build.ts",
        "package": "bun scripts/build.ts && electron-builder --mac --dir -c.mac.identity=- -c.mac.hardenedRuntime=false",
        "package:win": "bun scripts/build.ts win32-x64 win32-arm64 && electron-builder --win --dir --x64 --arm64",
        "release:mac": "electron-builder --mac --arm64 --x64 --publish never",
        "release:win": "electron-builder --win --x64 --arm64 --publish never",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
        "clean": "rm -rf node_modules/{*,.*} .turbo dist app bundle runtime release 2>/dev/null || true"
    },
    "dependencies": {
        "@clowdy/components": "workspace:*",
        "@clowdy/constants": "workspace:*",
        "@clowdy/file-manager": "workspace:*",
        "@clowdy/icons": "workspace:*",
        "@clowdy/lib": "workspace:*",
        "@clowdy/protocol": "workspace:*",
        "@clowdy/styles": "workspace:*",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-unicode11": "0.9.0",
        "@xterm/addon-web-links": "0.12.0",
        "@xterm/addon-webgl": "0.19.0",
        "@xterm/xterm": "6.0.0",
        "electron-updater": "^6.8.11",
        "mobx": "^7.0.3",
        "mobx-react-lite": "^5.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "streamdown": "2.7.1",
        "tinykeys": "4.0.1"
    },
    "devDependencies": {
        "@clowdy/config-typescript": "workspace:*",
        "@clowdy/eslint-config": "workspace:*",
        "electron": "45.2.1",
        "electron-builder": "^26.18.0"
    }
}
