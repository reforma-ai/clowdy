{
    "name": "@clowdy/daemon",
    "private": true,
    "description": "The Clowdy daemon: projects, chats, tasks, agent runs, worktrees, and documents behind a loopback HTTP + SSE API",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/main.ts",
        "start": "bun src/main.ts",
        "test": "bun test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf node_modules/{*,.*} .turbo 2>/dev/null || true",
        "stop": "bun src/stop.ts",
        "probe": "bun src/probe.ts"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "2.7.0",
        "@anthropic-ai/claude-agent-sdk": "0.3.325",
        "@clowdy/protocol": "workspace:*",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@clowdy/config-typescript": "workspace:*",
        "@clowdy/eslint-config": "workspace:*",
        "@modelcontextprotocol/sdk": "1.32.2"
    }
}
